{
  "name": "@arcanea/gemini",
  "version": "1.0.0",
  "description": "Google Gemini integration for Arcanea Intelligence OS - Multi-modal Guardian agents with vision capabilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vision": {
      "types": "./dist/vision.d.ts",
      "import": "./dist/vision.js"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/vision.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/vision.ts --format esm --dts --watch",
    "test": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write \"**/*.{js,ts,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,ts,md,json}\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "arcanea",
    "gemini",
    "google",
    "ai",
    "multimodal",
    "vision",
    "guardians"
  ],
  "author": "FrankX <frank@frankx.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankxai/gemini-arcanea.git"
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.4",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
